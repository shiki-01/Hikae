{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hikae",
  "version": "0.0.1",
  "identifier": "com.shiki01.hikae.mobile",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "img-src 'self' data: blob: https://avatars.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
