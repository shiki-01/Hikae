{
  "id": "hikae.builtin.preview",
  "name": "プレビュー（組み込み）",
  "version": "0.1.0",
  "apiVersion": "1",
  "contributes": {
    "renderers": [
      { "fileTypes": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp"], "modes": ["view", "compare"], "entry": "ui/index.html" },
      { "fileTypes": [".pdf"], "modes": ["view"], "entry": "ui/index.html" },
      { "fileTypes": [".docx"], "modes": ["view", "compare"], "entry": "ui/index.html" },
      { "fileTypes": [".xlsx"], "modes": ["view", "compare"], "entry": "ui/index.html" },
      { "fileTypes": [".pptx"], "modes": ["view"], "entry": "ui/index.html" },
      { "fileTypes": ["*"], "modes": ["view", "compare"], "entry": "ui/index.html" }
    ],
    "extractors": []
  },
  "permissions": []
}
