{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hikae",
  "version": "0.0.1",
  "identifier": "com.shiki01.hikae",
  "build": {
    "beforeDevCommand": "node scripts/fetch-git-windows.mjs && node scripts/fetch-llama-windows.mjs && node scripts/build-extensions.mjs && pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/fetch-git-windows.mjs && node scripts/fetch-llama-windows.mjs && pnpm build",
    "frontendDist": "../../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hikae",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "img-src 'self' app-blob: http://app-blob.localhost https://avatars.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/git": "git",
      "resources/llama": "llama",
      "resources/extensions": "extensions",
      "resources/NOTICE.txt": "NOTICE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
