# 同梱する git（scripts/fetch-git-windows.mjs・scripts/build-git-macos.sh が生成する。バイナリはコミットしない）
/src-tauri/app/resources/git/*
!/src-tauri/app/resources/git/.gitkeep
/src-tauri/app/resources/.git-staging/
