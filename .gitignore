# Node / SvelteKit
node_modules/
.pnpm-store/
/build
/.svelte-kit
/dist
*.tsbuildinfo
.env
.env.*
!.env.example

# Rust / Tauri
target/
/src-tauri/app/gen/

# OS の一時ファイル
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# エディタ
.vscode/
.idea/
*.swp
*.swo

# Claude Code のローカル設定
.claude
.claude/settings.local.json

# 単体の rustc 実験で出る成果物
*.rlib

# 同梱する git（scripts/fetch-git-windows.mjs・scripts/build-git-macos.sh が生成する。バイナリはコミットしない）
/src-tauri/app/resources/git/*
!/src-tauri/app/resources/git/.gitkeep
/src-tauri/app/resources/.git-staging/

# 同梱のローカル LLM（scripts/fetch-llama-windows.mjs が生成する。バイナリはコミットしない）
/src-tauri/app/resources/llama/*
!/src-tauri/app/resources/llama/.gitkeep
/src-tauri/app/resources/.llama-staging/

# 組み込みの拡張の wasm（scripts/build-extensions.mjs が生成する。バイナリはコミットしない。extension.json は入れる）
/src-tauri/app/resources/extensions/*/*.wasm

# 表示拡張（iframe の UI）のビルド出力（scripts/build-extensions.mjs が vite.ext.config.ts で生成する）
/src-tauri/app/resources/extensions/*/ui/
